<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"  
           xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"  
           x:Class="TOYOTA.AutosInfo.Corolla"  
           Title="Corolla">
    <ScrollView>
        <StackLayout Padding="20" Spacing="20" BackgroundColor="White">  

           <!-- Imagen del vehículo -->
            <Frame HasShadow="True" CornerRadius="15" Padding="0">
                <Image Source="corolla2.jpg"
                   Aspect="AspectFill"
                   HorizontalOptions="FillAndExpand"
                   VerticalOptions="FillAndExpand"
                   HeightRequest="250"/>
            </Frame>

            <!-- Nombre y modelo -->  
           <Label Text="Toyota Corolla 2025"  
                  FontSize="24"  
                  FontAttributes="Bold"  
                  TextColor="#212121"/>  

           <!-- Especificaciones clave -->  
           <Grid ColumnSpacing="20" RowSpacing="10">  
               <Grid.RowDefinitions>  
                   <RowDefinition Height="Auto"/>  
                   <RowDefinition Height="Auto"/>  
               </Grid.RowDefinitions>  
               <Grid.ColumnDefinitions>  
                   <ColumnDefinition Width="*"/>  
                   <ColumnDefinition Width="*"/>  
                   <ColumnDefinition Width="*"/>  
               </Grid.ColumnDefinitions>  

               <!-- Motor -->  
               <StackLayout Grid.Row="0" Grid.Column="0" HorizontalOptions="Center">  
                   <Image Source="motorcoche.png" HeightRequest="40"/>  
                   <Label Text="2.0L 4Cil" FontSize="14" TextColor="#424242"/>  
               </StackLayout>  

               <!-- Combustible -->  
               <StackLayout Grid.Row="0" Grid.Column="1" HorizontalOptions="Center">  
                   <Image Source="bombagasolina.png" HeightRequest="40"/>  
                   <Label Text="Gasolina" FontSize="14" TextColor="#424242"/>  
               </StackLayout>  

               <!-- Transmisión -->  
               <StackLayout Grid.Row="0" Grid.Column="2" HorizontalOptions="Center">  
                   <Image Source="transmisionmanual.png" HeightRequest="40"/>  
                   <Label Text="Automática" FontSize="14" TextColor="#424242"/>  
               </StackLayout>  
           </Grid>  

           <!-- Descripción -->  
           <Label Text="El Toyota Corolla 2025 combina eficiencia, tecnología y diseño moderno. Equipado con un motor de 2.0L, ofrece una conducción suave y segura. Su interior cuenta con una pantalla táctil de 8 pulgadas, conectividad Bluetooth y sistema de asistencia al conductor."  
                  FontSize="16"  
                  TextColor="#616161"  
                  LineHeight="1.5"/>

            <Button Text="Reservar Vehiculo"  BackgroundColor="#E53935"   TextColor="White"  CornerRadius="10"  HeightRequest="50"   FontAttributes="Bold"  Clicked="OnSolicitarInformacionClicked"/>



        </StackLayout>
    </ScrollView>  
</ContentPage>
